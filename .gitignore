# --- Documents and derived data (hard rules 1-2) ---
*.pdf
*.PDF
*.doc
*.docx
*.odt
*.rtf
*.eml
*.msg
*.zip
full.md
summary.md
# OCR intermediates and screenshots
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.heic

# --- Runtime state and logs ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.log
logs/
inbox/
outbox/
data/
